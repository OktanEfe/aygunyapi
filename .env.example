# Yayın adresi (sitemap, canonical, Open Graph için)
NEXT_PUBLIC_SITE_URL=https://aygundecor.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Formların gideceği adres (boşsa site e-postası kullanılır)
CONTACT_TO_EMAIL=aygunyapi@hotmail.com
# Resend'de doğrulanmış alan adından gönderici. Alan adı doğrulanana kadar
# "Aygün Yapı <onboarding@resend.dev>" kullanılabilir (yalnızca hesap sahibine gönderir).
CONTACT_FROM_EMAIL=Aygün Yapı <form@aygundecor.com>
